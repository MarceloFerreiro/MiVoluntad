# Copie este archivo como .env y rellene los valores. El .env nunca se sube a git.

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# WhatsApp con Twilio (opcional). Consola de Twilio -> Account -> API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remitente: el número del sandbox de WhatsApp de Twilio o el vuestro, con prefijo whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública EXACTA configurada como webhook en Twilio (por ejemplo, con ngrok)
PUBLIC_URL=https://xxxx.ngrok-free.app/whatsapp
# twiml: responde dentro del webhook (necesario en el número de pruebas "Try it out" / sandbox)
# api: responde por la API REST (remitente propio de WhatsApp Business)
WHATSAPP_MODO=twiml

# Borrado automático de conversaciones sin uso (días)
RETENTION_DAYS=30

# Opcional: notarías concretas con teléfono y horario (Google Places API, requiere facturación en Google Cloud)
GOOGLE_MAPS_API_KEY=

# Reconocimiento de voz local: small (rápido, por defecto) o medium (más preciso, ~3 veces más lento)
WHISPER_MODEL=small
